<p align="center"><span style="FONT-SIZE: 12pt; COLOR: black">Кандела</span></p></td>
<td style="BORDER-RIGHT: windowtext 1pt solid; PADDING-RIGHT: 2.85pt; BORDER-TOP: #d4d0c8; PADDING-LEFT: 2.85pt; BACKGROUND: white; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #d4d0c8; PADDING-TOP: 1.4pt; BORDER-BOTTOM: windowtext 1pt solid; HEIGHT: 1cm" valign="top" width="5%">
<p align="center"><span style="FONT-SIZE: 12pt; COLOR: black">сd</span></p></td>
